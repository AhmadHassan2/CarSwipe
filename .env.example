# --- Required -------------------------------------------------------------
# PostgreSQL connection string. Locally, Homebrew Postgres needs no password.
DATABASE_URL="postgresql://YOUR_USER@localhost:5432/carswipe"
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional: Google sign-in ---------------------------------------------
# Leave blank to hide the "Continue with Google" button.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Optional: Cloudinary image storage ------------------------------------
# Leave blank to store uploads on local disk in public/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
